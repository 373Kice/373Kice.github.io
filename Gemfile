source "https://rubygems.org"

# Jekyll and common plugins used by this site
# Version constraints ensure compatibility with GitHub Pages build environment
gem "jekyll", "~> 4.4"
gem "jekyll-paginate", "~> 1.1"
gem "kramdown", "~> 2.5"
gem "rouge", "~> 4.5"

# For Ruby >= 3.0, webrick is not bundled
gem "webrick", "~> 1.9"

# Windows-specific gem to avoid polling for changes
gem "wdm", "~> 0.2" if Gem.win_platform?
